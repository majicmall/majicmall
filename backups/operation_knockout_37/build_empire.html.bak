{% extends "base.html" %}

{% block title %}Build Your Empire™ | MajicMall Megaverse{% endblock %}

{% block content %}
<style>
  .empire-page {
    min-height: 100vh;
    padding: 70px 18px;
    color: #fff;
    background:
      radial-gradient(circle at top, rgba(212,175,55,.20), transparent 34%),
      linear-gradient(145deg, #020202, #101010 52%, #000);
  }

  .empire-shell {
    width: min(980px, 100%);
    margin: auto;
  }

  .empire-heading {
    text-align: center;
    margin-bottom: 34px;
  }

  .empire-heading h1 {
    margin: 0;
    color: #f4d675;
    font-family: Georgia, serif;
    font-size: clamp(2.5rem, 7vw, 5rem);
    letter-spacing: .08em;
    text-shadow: 0 0 24px rgba(244,214,117,.42);
  }

  .empire-heading p {
    max-width: 700px;
    margin: 14px auto 0;
    color: #ddd;
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .empire-card {
    border: 1px solid rgba(244,214,117,.55);
    border-radius: 22px;
    padding: clamp(24px, 5vw, 46px);
    background: rgba(8,8,8,.92);
    box-shadow: 0 22px 70px rgba(0,0,0,.7),
                0 0 34px rgba(212,175,55,.12);
  }

  .plan-badge {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 30px;
    padding: 18px 20px;
    border: 1px solid rgba(244,214,117,.42);
    border-radius: 15px;
    background: linear-gradient(135deg, rgba(212,175,55,.18), rgba(255,255,255,.03));
  }

  .plan-badge strong {
    color: #f4d675;
    text-transform: uppercase;
    letter-spacing: .12em;
  }

  .empire-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .full {
    grid-column: 1 / -1;
  }

  .empire-field label {
    display: block;
    margin-bottom: 7px;
    color: #f2dc94;
    font-weight: 700;
  }

  .empire-field input,
  .empire-field select {
    box-sizing: border-box;
    width: 100%;
    padding: 14px 15px;
    color: #fff;
    border: 1px solid #555;
    border-radius: 10px;
    outline: none;
    background: #101010;
  }

  .empire-field input:focus,
  .empire-field select:focus {
    border-color: #f4d675;
    box-shadow: 0 0 0 3px rgba(244,214,117,.12);
  }

  .agreement {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 24px 0;
    color: #ddd;
    line-height: 1.55;
  }

  .agreement input {
    margin-top: 5px;
  }

  .empire-submit {
    width: 100%;
    padding: 17px 22px;
    border: 1px solid #fff0ad;
    border-radius: 11px;
    color: #080808;
    background: linear-gradient(135deg, #fff0ad, #c79624);
    font-size: 1.02rem;
    font-weight: 900;
    letter-spacing: .1em;
    cursor: pointer;
    box-shadow: 0 0 24px rgba(244,214,117,.25);
  }

  .signin {
    margin-top: 22px;
    text-align: center;
    color: #ccc;
  }

  .signin a {
    color: #f4d675;
    font-weight: 800;
  }

  .messages {
    margin-bottom: 20px;
  }

  .message {
    margin-bottom: 9px;
    padding: 12px 14px;
    border: 1px solid #8d7427;
    border-radius: 9px;
    background: rgba(141,116,39,.18);
  }


  .foundation-access {
    grid-column: 1 / -1;
    padding: 22px;
    border: 1px solid rgba(244,214,117,.65);
    border-radius: 16px;
    background:
      radial-gradient(
        circle at top,
        rgba(244,214,117,.16),
        transparent 68%
      ),
      rgba(18,14,4,.78);
    box-shadow:
      inset 0 0 28px rgba(244,214,117,.06),
      0 0 22px rgba(244,214,117,.07);
  }

  .foundation-access h2 {
    margin: 0 0 8px;
    color: #f4d675;
    font-family: Georgia, serif;
    letter-spacing: .07em;
  }

  .foundation-access p {
    margin: 0 0 16px;
    color: #ddd;
    line-height: 1.65;
  }

  .foundation-benefits {
    margin: 0 0 18px;
    padding-left: 20px;
    color: #f5e6ac;
    line-height: 1.8;
  }

  @media (max-width: 700px) {
    .empire-grid {
      grid-template-columns: 1fr;
    }

    .full {
      grid-column: auto;
    }

    .plan-badge {
      flex-direction: column;
    }
  }
</style>

<section class="empire-page">
  <div class="empire-shell">
    <header class="empire-heading">
      <h1>BUILD YOUR EMPIRE™</h1>
      <p>
        Every great empire begins with a single vision.
        Today, yours begins inside MajicMall Megaverse.
      </p>
    </header>

    <div class="empire-card">
      {% if messages %}
        <div class="messages">
          {% for message in messages %}
            <div class="message">{{ message }}</div>
          {% endfor %}
        </div>
      {% endif %}

      <div class="plan-badge">
        <div>
          <small>YOUR SELECTED SUCCESS PLAN</small><br>
          <strong>{{ plan|title }}</strong>
        </div>

        <strong>${{ plan_price|floatformat:2 }} / month</strong>
      </div>

      <form method="post">
        {% csrf_token %}
        <input type="hidden" name="plan" value="{{ plan }}">

        <div class="empire-grid">
          <div class="empire-field">
            <label for="first_name">First Name</label>
            <input id="first_name" name="first_name" required
                   value="{{ request.POST.first_name }}">
          </div>

          <div class="empire-field">
            <label for="last_name">Last Name</label>
            <input id="last_name" name="last_name" required
                   value="{{ request.POST.last_name }}">
          </div>

          <div class="empire-field full">
            <label for="business_name">Business / Store Name</label>
            <input id="business_name" name="business_name" required
                   value="{{ request.POST.business_name }}">
          </div>

          <div class="empire-field">
            <label for="business_category">Business Category</label>
            <input id="business_category" name="business_category"
                   placeholder="Fashion, Food, Entertainment..."
                   value="{{ request.POST.business_category }}">
          </div>

          <div class="empire-field">
            <label for="phone">Phone</label>
            <input id="phone" name="phone" type="tel"
                   value="{{ request.POST.phone }}">
          </div>

          <div class="empire-field full">
            <label for="email">Email Address</label>
            <input id="email" name="email" type="email" required
                   value="{{ request.POST.email }}">
          </div>

          <div class="empire-field">
            <label for="password">Create Password</label>
            <input id="password" name="password" type="password"
                   minlength="8" required>
          </div>

          <div class="empire-field">
            <label for="password_confirm">Confirm Password</label>
            <input id="password_confirm" name="password_confirm"
                   type="password" minlength="8" required>
          </div>


          {% if plan == "foundation" %}
            <section class="foundation-access">
              <h2>🏅 Foundation Merchant Access</h2>

              <p>
                This protected membership is reserved for approved
                original merchants of the MajicMall Megaverse.
              </p>

              <ul class="foundation-benefits">
                <li>Vision Success Plan equivalent benefits</li>
                <li>Complimentary membership for one full year</li>
                <li>One included Zone Storefront</li>
                <li>100 Majestic Coins welcome award</li>
                <li>Permanent Foundation Merchant recognition</li>
              </ul>

              <div class="empire-field">
                <label for="foundation_majic_key">
                  PassKey MajicKey
                </label>

                <input
                  id="foundation_majic_key"
                  name="foundation_majic_key"
                  type="password"
                  autocomplete="off"
                  required
                  placeholder="Enter your approved MajicKey"
                >
              </div>
            </section>
          {% endif %}
        </div>

        <label class="agreement">
          <input type="checkbox" name="agreement" value="yes" required>
          <span>
            I agree to the MajicMall Megaverse Merchant Agreement.
            {% if plan == "foundation" %}
              I understand that my complimentary Foundation year
              transitions to the Vision Success Plan after one year,
              subject to advance notice and payment authorization.
            {% else %}
              I authorize recurring billing for my selected Success Plan.
            {% endif %}
          </span>
        </label>

        <button class="empire-submit" type="submit">
          {% if plan == "foundation" %}
            ACTIVATE FOUNDATION MEMBERSHIP
          {% else %}
            CONTINUE TO SECURE PAYMENT
          {% endif %}
        </button>
      </form>

      <div class="signin">
        Already building your empire?
        <a href="{% url 'account_login' %}">Sign In</a>
      </div>
    </div>
  </div>
</section>
{% endblock %}
