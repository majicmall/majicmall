/* ==========================================
   SAFE STOREFRONT IMAGE FALLBACK
========================================== */

.storefront-image-fallback {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background:
        radial-gradient(circle at 50% 15%, rgba(255, 215, 90, 0.22), transparent 34%),
        linear-gradient(145deg, #191919 0%, #050505 56%, #140d02 100%);
}

.storefront-image-fallback::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(
            115deg,
            transparent 20%,
            rgba(255, 255, 255, 0.08) 44%,
            transparent 62%
        );
    transform: translateX(-120%);
    animation: storefrontFallbackGleam 6s ease-in-out infinite;
}

.storefront-image-fallback > img {
    width: 72%;
    height: 72%;
    object-fit: contain;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.75));
}

.storefront-fallback-mark {
    position: relative;
    z-index: 2;
    min-height: 150px;
    width: min(82%, 320px);
    padding: 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    text-align: center;
    border: 1px solid rgba(255, 215, 90, 0.42);
    background: rgba(0, 0, 0, 0.48);
    box-shadow:
        inset 0 0 24px rgba(255, 215, 90, 0.06),
        0 12px 32px rgba(0, 0, 0, 0.42);
    backdrop-filter: blur(8px);
}

.storefront-fallback-icon {
    color: #f6d978;
    font-size: 24px;
    line-height: 1;
    text-shadow: 0 0 18px rgba(246, 217, 120, 0.65);
}

.storefront-fallback-mark strong {
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    letter-spacing: 0.04em;
}

.storefront-fallback-mark small {
    color: #dfc36d;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
}

@keyframes storefrontFallbackGleam {
    0%,
    58% {
        transform: translateX(-120%);
    }

    78%,
    100% {
        transform: translateX(120%);
    }
}


@keyframes grandConcourseLightSweep{

    from{
        transform:translateX(-45%);
    }

    to{
        transform:translateX(45%);
    }

}
