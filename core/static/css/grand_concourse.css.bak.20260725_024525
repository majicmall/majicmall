/* ==========================================
   MAJESTICMALL GRAND CONCOURSE
========================================== */

.grand-concourse{
    position:relative;
    width:100%;
    overflow:hidden;
    padding:70px 30px;

    background:
        linear-gradient(
            rgba(0,0,0,.72),
            rgba(0,0,0,.80)
        ),
        url("../img/grand_concourse_desktop.png")
        center center/cover no-repeat;

    background-attachment:fixed;
}

.grand-concourse::before{
    content:"";
    position:absolute;
    inset:0;

    background:
        linear-gradient(
            rgba(0,0,0,.18),
            rgba(0,0,0,.60),
            rgba(0,0,0,.85)
        ),
        radial-gradient(
            circle at center,
            rgba(255,215,0,.08) 0%,
            rgba(255,215,0,.03) 38%,
            transparent 72%
        );

    backdrop-filter:blur(3px);
    z-index:1;
}


.grand-concourse::after{
    content:"";
    position:absolute;
    inset:0;

    background:
        linear-gradient(
            120deg,
            transparent 0%,
            rgba(255,255,255,.025) 30%,
            rgba(255,215,0,.05) 42%,
            rgba(255,255,255,.02) 55%,
            transparent 70%
        );

    animation:grandConcourseLightSweep 22s linear infinite;
    pointer-events:none;
    z-index:2;
}

.grand-content{
    position:relative;
    z-index:5;
    max-width:1600px;
    margin:auto;
}

@media(max-width:768px){

.grand-concourse{
    padding:35px 14px;
    background:
        linear-gradient(
            rgba(0,0,0,.74),
            rgba(0,0,0,.82)
        ),
        url("../img/grand_concourse_mobile.png");
    background-position:center top;
}

}

