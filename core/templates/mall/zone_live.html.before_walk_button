{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ zone.name }} - Majic Mall</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<style>

  /* ========================================================
     WALK THE MALL BUTTON
     ======================================================== */

  .walk-the-mall-launch {
    display: flex;
    justify-content: center;
    margin: 22px auto 30px;
    padding: 0 16px;
  }

  .walk-the-mall-button {
    position: relative;
    display: inline-flex;
    width: min(430px, 100%);
    min-height: 76px;
    align-items: center;
    gap: 15px;
    overflow: hidden;
    padding: 13px 20px;
    border: 1px solid rgba(255, 231, 145, 0.82);
    border-radius: 18px;
    color: #fff;
    background:
      linear-gradient(
        135deg,
        rgba(8, 8, 10, 0.98),
        rgba(45, 32, 5, 0.96)
      );
    box-shadow:
      0 18px 45px rgba(0, 0, 0, 0.5),
      0 0 22px rgba(212, 175, 55, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.13);
    text-decoration: none;
    transition:
      transform 0.24s ease,
      border-color 0.24s ease,
      box-shadow 0.24s ease;
    isolation: isolate;
  }

  .walk-the-mall-button::before {
    position: absolute;
    z-index: -1;
    top: -70%;
    left: -30%;
    width: 35%;
    height: 240%;
    content: "";
    transform: rotate(22deg);
    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(255, 246, 202, 0.34),
        transparent
      );
    animation: walkButtonGleam 4.8s ease-in-out infinite;
  }

  .walk-the-mall-button:hover,
  .walk-the-mall-button:focus-visible {
    transform: translateY(-3px) scale(1.015);
    border-color: #fff1ae;
    box-shadow:
      0 22px 55px rgba(0, 0, 0, 0.62),
      0 0 34px rgba(212, 175, 55, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
    outline: none;
  }

  .walk-button-icon {
    display: grid;
    width: 46px;
    height: 46px;
    flex: 0 0 46px;
    place-items: center;
    border: 1px solid rgba(255, 237, 170, 0.55);
    border-radius: 50%;
    background:
      radial-gradient(
        circle at 35% 28%,
        #fff4bd,
        #d4af37 58%,
        #725200
      );
    box-shadow:
      0 0 20px rgba(212, 175, 55, 0.3);
    font-size: 1.35rem;
  }

  .walk-button-copy {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    text-align: left;
  }

  .walk-button-copy strong {
    color: #fff0ad;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.08rem, 2.4vw, 1.4rem);
    letter-spacing: 0.025em;
  }

  .walk-button-copy small {
    overflow: hidden;
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.045em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .walk-button-arrow {
    color: #fff0ad;
    font-size: 1.55rem;
    transition: transform 0.24s ease;
  }

  .walk-the-mall-button:hover .walk-button-arrow,
  .walk-the-mall-button:focus-visible .walk-button-arrow {
    transform: translateX(5px);
  }

  @keyframes walkButtonGleam {
    0%,
    55% {
      left: -35%;
      opacity: 0;
    }

    68% {
      opacity: 1;
    }

    88%,
    100% {
      left: 125%;
      opacity: 0;
    }
  }

  @media (max-width: 520px) {
    .walk-the-mall-launch {
      margin-top: 18px;
    }

    .walk-the-mall-button {
      min-height: 70px;
      gap: 11px;
      padding: 11px 14px;
      border-radius: 15px;
    }

    .walk-button-icon {
      width: 41px;
      height: 41px;
      flex-basis: 41px;
      font-size: 1.15rem;
    }

    .walk-button-copy small {
      font-size: 0.64rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .walk-the-mall-button,
    .walk-button-arrow {
      transition: none;
    }

    .walk-the-mall-button::before {
      animation: none;
    }
  }

</style>
</head>
<body class="bg-black text-white min-h-screen">
  <div class="max-w-6xl mx-auto px-6 py-10">
    <a href="{% url 'mall-directory' %}" class="inline-block mb-6 px-4 py-2 bg-gray-800 rounded-lg hover:bg-gray-700">
      ← Back to Directory
    </a>

    <h1 class="text-4xl font-bold text-yellow-400 mb-3">{{ zone.name }}</h1>

  <!-- WALK THE MALL BUTTON -->
  <div class="walk-the-mall-launch">
    <a
      class="walk-the-mall-button"
      href="{% url 'walk-zone' zone_slug=zone.slug %}"
      aria-label="Walk through {{ zone.name }}"
    >
      <span class="walk-button-icon" aria-hidden="true">🚶</span>

      <span class="walk-button-copy">
        <strong>Walk the Mall™</strong>
        <small>Explore {{ zone.name }} storefronts</small>
      </span>

      <span class="walk-button-arrow" aria-hidden="true">→</span>
    </a>
  </div>


    {% if zone.description %}
      <p class="text-gray-300 mb-8">{{ zone.description }}</p>
    {% endif %}

    {% if stores %}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {% for store in stores %}
          <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 shadow-xl">
            <h2 class="text-2xl font-semibold text-white">{{ store.store_name }}</h2>

            {% if store.slogan %}
              <p class="text-gray-400 mt-2">{{ store.slogan }}</p>
            {% elif store.description %}
              <p class="text-gray-400 mt-2">{{ store.description|truncatewords:20 }}</p>
            {% endif %}

            <div class="mt-5">
              {% if store.slug %}
                <a href="{% url 'storefront' store.slug %}"
                   class="inline-block px-4 py-2 bg-yellow-400 text-black rounded-xl font-medium hover:opacity-90">
                  Visit Store
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="bg-gray-900 border border-gray-800 rounded-2xl p-8 text-gray-400">
        No stores are currently available in this zone.
      </div>
    {% endif %}
  </div>
</body>
</html>
