{% extends "delivery/driver_base.html" %}

{% block title %}
  Driver Command Center | MajicMall Megaverse Driver Network
{% endblock %}

{% block extra_css %}
  <style>
    .dashboard-heading {
      margin-bottom: 28px;
    }

    .dashboard-heading h1 {
      font-size: clamp(2rem, 7vw, 4rem);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(
        auto-fit,
        minmax(210px, 1fr)
      );
      gap: 18px;
      margin-bottom: 24px;
    }

    .stat-card {
      padding: 25px;
      border: 1px solid var(--border);
      border-radius: 20px;
      background:
        linear-gradient(
          145deg,
          rgba(255, 255, 255, 0.065),
          rgba(255, 255, 255, 0.015)
        ),
        #0d0d0d;
    }

    .stat-label {
      color: var(--muted);
      font-size: 0.88rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .stat-number {
      margin-top: 9px;
      color: var(--gold-bright);
      font-size: clamp(2.4rem, 8vw, 4rem);
      font-weight: 900;
      line-height: 1;
    }

    .profile-grid {
      display: grid;
      grid-template-columns: repeat(
        auto-fit,
        minmax(210px, 1fr)
      );
      gap: 14px;
    }

    .profile-item {
      padding: 16px;
      border: 1px solid rgba(255, 255, 255, 0.11);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.035);
    }

    .profile-label {
      display: block;
      margin-bottom: 7px;
      color: #9e9e9e;
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .profile-value {
      color: var(--white);
      font-weight: 800;
    }

    .job {
      padding: 20px 0;
      border-top: 1px solid rgba(242, 202, 82, 0.24);
    }

    .job:first-of-type {
      border-top: 0;
    }

    .job-title {
      margin-bottom: 10px;
      color: var(--gold-bright);
      font-size: 1.08rem;
      font-weight: 800;
    }

    .job-details {
      display: grid;
      grid-template-columns: repeat(
        auto-fit,
        minmax(170px, 1fr)
      );
      gap: 10px;
      color: var(--muted);
      line-height: 1.55;
    }

    .empty-state {
      margin: 0;
      padding: 22px;
      border: 1px dashed rgba(255, 255, 255, 0.2);
      border-radius: 14px;
      color: var(--muted);
      text-align: center;
    }

    .warning-panel {
      border-color: rgba(255, 123, 123, 0.48);
      background: rgba(255, 123, 123, 0.055);
    }

    /* ACTIVE DELIVERY CENTER — START */

    .active-delivery-center {
      position: relative;
      overflow: hidden;
      margin-bottom: 24px;
      padding: clamp(22px, 4vw, 34px);
      border: 1px solid rgba(242, 202, 82, 0.48);
      border-radius: 24px;
      background:
        radial-gradient(
          circle at top right,
          rgba(242, 202, 82, 0.13),
          transparent 35%
        ),
        linear-gradient(
          145deg,
          rgba(255, 255, 255, 0.07),
          rgba(255, 255, 255, 0.018)
        ),
        #090909;
      box-shadow:
        0 25px 70px rgba(0, 0, 0, 0.46),
        0 0 32px rgba(242, 202, 82, 0.08);
    }

    .active-delivery-center::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(
          115deg,
          transparent 20%,
          rgba(255, 255, 255, 0.035) 43%,
          transparent 65%
        );
      transform: translateX(-100%);
      animation: activeCenterShine 7s ease-in-out infinite;
    }

    @keyframes activeCenterShine {
      0%,
      65% {
        transform: translateX(-100%);
      }

      100% {
        transform: translateX(100%);
      }
    }

    .active-center-header {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 22px;
      flex-wrap: wrap;
    }

    .active-center-eyebrow {
      margin: 0 0 8px;
      color: var(--gold-bright);
      font-size: 0.76rem;
      font-weight: 900;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .active-center-header h2 {
      margin: 0;
      color: var(--white);
      font-size: clamp(1.65rem, 5vw, 2.5rem);
    }

    .active-center-description {
      max-width: 670px;
      margin: 9px 0 0;
      color: var(--muted);
      line-height: 1.6;
    }

    .active-count-badge {
      display: inline-flex;
      min-width: 58px;
      min-height: 58px;
      align-items: center;
      justify-content: center;
      padding: 10px;
      border: 1px solid rgba(242, 202, 82, 0.5);
      border-radius: 18px;
      color: #090909;
      background:
        linear-gradient(
          135deg,
          #fff0ad,
          #d6a82d
        );
      font-size: 1.6rem;
      font-weight: 950;
      box-shadow: 0 0 24px rgba(242, 202, 82, 0.16);
    }

    .active-delivery-list {
      position: relative;
      z-index: 1;
      display: grid;
      gap: 18px;
    }

    .active-delivery-card {
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.11);
      border-radius: 20px;
      background: rgba(0, 0, 0, 0.42);
    }

    .active-delivery-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 18px 20px;
      border-bottom: 1px solid rgba(242, 202, 82, 0.16);
      flex-wrap: wrap;
    }

    .active-delivery-card-title {
      margin: 0;
      color: var(--gold-bright);
      font-size: 1.12rem;
      font-weight: 900;
    }

    .active-status {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 12px;
      border: 1px solid rgba(242, 202, 82, 0.4);
      border-radius: 999px;
      color: #ffe9a4;
      background: rgba(242, 202, 82, 0.075);
      font-size: 0.78rem;
      font-weight: 900;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .active-status::before {
      content: "";
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #f2ca52;
      box-shadow: 0 0 12px rgba(242, 202, 82, 0.8);
    }

    .active-delivery-route {
      display: grid;
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
      gap: 14px;
      padding: 18px 20px;
    }

    .route-stop {
      padding: 17px;
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.035);
    }

    .route-label {
      display: block;
      margin-bottom: 8px;
      color: #999;
      font-size: 0.72rem;
      font-weight: 900;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .route-primary {
      display: block;
      color: #fff;
      font-size: 1.02rem;
      font-weight: 900;
      line-height: 1.4;
    }

    .route-address {
      margin: 8px 0 0;
      color: var(--muted);
      line-height: 1.55;
    }

    .active-order-line {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 0 20px 18px;
      color: var(--muted);
      flex-wrap: wrap;
    }

    .active-order-line strong {
      color: #fff;
    }

    .active-delivery-actions {
      display: grid;
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
      gap: 10px;
      padding: 18px 20px 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .driver-tool-button {
      display: inline-flex;
      min-height: 50px;
      align-items: center;
      justify-content: center;
      padding: 12px 16px;
      border: 1px solid transparent;
      border-radius: 14px;
      font: inherit;
      font-weight: 900;
      text-align: center;
      text-decoration: none;
      cursor: pointer;
    }

    .driver-tool-button.resume {
      grid-column: 1 / -1;
      color: #080808;
      background:
        linear-gradient(
          135deg,
          #fff0ad,
          #d6a82d
        );
      box-shadow: 0 10px 25px rgba(242, 202, 82, 0.13);
    }

    .driver-tool-button.message {
      color: #fff;
      border-color: rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.06);
    }

    .driver-tool-button.cancel {
      grid-column: 1 / -1;
      width: 100%;
      color: #ffd6d6;
      border-color: rgba(255, 100, 100, 0.35);
      background: rgba(160, 25, 25, 0.18);
    }

    .view-all-active {
      position: relative;
      z-index: 1;
      display: flex;
      justify-content: center;
      margin-top: 20px;
    }

    .view-all-active a {
      color: var(--gold-bright);
      font-weight: 900;
      text-decoration: none;
    }

    .active-center-empty {
      position: relative;
      z-index: 1;
      padding: 24px;
      border: 1px dashed rgba(255, 255, 255, 0.17);
      border-radius: 16px;
      color: var(--muted);
      text-align: center;
    }

    @media (max-width: 720px) {
      .active-delivery-route,
      .active-delivery-actions {
        grid-template-columns: 1fr;
      }

      .driver-tool-button.resume,
      .driver-tool-button.cancel {
        grid-column: auto;
      }

      .active-count-badge {
        min-width: 50px;
        min-height: 50px;
        font-size: 1.3rem;
      }
    }

    /* ACTIVE DELIVERY CENTER — END */

  </style>
{% endblock %}

{% block content %}
  <section class="dashboard-heading">
    <p class="eyebrow">
      MajicMall Megaverse Driver Network
    </p>

    <h1>
      Driver Command Center
    </h1>

    {% if partner %}
      <p class="lead">
        Welcome, {{ partner.full_name }}. Manage your delivery
        activity, working area, and earnings.
      </p>
    {% else %}
      <p class="lead">
        Register as a driver to access available deliveries and
        Driver Command Center features.
      </p>
    {% endif %}
  </section>

  <section class="stats-grid">
    <article class="stat-card">
      <div class="stat-label">
        Available Deliveries
      </div>

      <div class="stat-number">
        {{ pending_jobs }}
      </div>
    </article>

    <article class="stat-card">
      <div class="stat-label">
        Active Deliveries
      </div>

      <div class="stat-number">
        {{ active_jobs }}
      </div>
    </article>

    <article class="stat-card">
      <div class="stat-label">
        Completed Deliveries
      </div>

      <div class="stat-number">
        {{ completed_jobs }}
      </div>
    </article>
  </section>


  <!-- ACTIVE DELIVERY CENTER — START -->
  {% if partner and partner.is_ready_for_command_center %}
    <section class="active-delivery-center">
      <div class="active-center-header">
        <div>
          <p class="active-center-eyebrow">
            Transport Partner Toolbox
          </p>

          <h2>
            Active Delivery Center
          </h2>

          <p class="active-center-description">
            Resume navigation, review pickup and drop-off information,
            contact the merchant or customer, and manage accepted
            deliveries.
          </p>
        </div>

        <div
          class="active-count-badge"
          aria-label="{{ active_jobs }} active deliveries"
        >
          {{ active_jobs }}
        </div>
      </div>

      {% if active_delivery_jobs %}
        <div class="active-delivery-list">
          {% for job in active_delivery_jobs %}
            <article class="active-delivery-card">
              <header class="active-delivery-card-header">
                <h3 class="active-delivery-card-title">
                  Delivery #{{ job.id }}
                </h3>

                <span class="active-status">
                  {{ job.get_status_display }}
                </span>
              </header>

              <div class="active-delivery-route">
                <div class="route-stop">
                  <span class="route-label">
                    🏪 Merchant Pickup
                  </span>

                  <strong class="route-primary">
                    {{ job.store.store_name|default:"Merchant" }}
                  </strong>

                  <p class="route-address">
                    {% if job.store.street_address %}
                      {{ job.store.street_address }}

                      {% if job.store.address_line_2 %}
                        <br>{{ job.store.address_line_2 }}
                      {% endif %}

                      {% if job.store.city or job.store.state or job.pickup_zip %}
                        <br>
                        {{ job.store.city }}
                        {% if job.store.city and job.store.state %}, {% endif %}
                        {{ job.store.state }}
                        {{ job.pickup_zip }}
                      {% endif %}

                    {% elif job.store.address %}
                      {{ job.store.address }}

                    {% elif job.pickup_zip %}
                      Pickup ZIP: {{ job.pickup_zip }}

                    {% else %}
                      Open the delivery to view pickup information.
                    {% endif %}
                  </p>
                </div>

                <div class="route-stop">
                  <span class="route-label">
                    👤 Customer Drop-Off
                  </span>

                  <strong class="route-primary">
                    {{ job.order.customer_name|default:"Customer" }}
                  </strong>

                  <p class="route-address">
                    {% if job.order.delivery_address %}
                      {{ job.order.delivery_address }}

                    {% elif job.order.shipping_address %}
                      {{ job.order.shipping_address }}

                    {% elif job.order.street_address %}
                      {{ job.order.street_address }}

                      {% if job.order.address_line_2 %}
                        <br>{{ job.order.address_line_2 }}
                      {% endif %}

                      {% if job.order.city or job.order.state or job.delivery_zip %}
                        <br>
                        {{ job.order.city }}
                        {% if job.order.city and job.order.state %}, {% endif %}
                        {{ job.order.state }}
                        {{ job.delivery_zip }}
                      {% endif %}

                    {% elif job.delivery_zip %}
                      Delivery ZIP: {{ job.delivery_zip }}

                    {% else %}
                      Open the delivery to view drop-off information.
                    {% endif %}
                  </p>
                </div>
              </div>

              <div class="active-order-line">
                <span>
                  Order
                  <strong>
                    #{{ job.order.id }}
                  </strong>
                </span>

                <span>
                  Driver payout
                  <strong>
                    ${{ job.total_driver_payout|floatformat:2 }}
                  </strong>
                </span>
              </div>

              <div class="active-delivery-actions">
                <a
                  class="driver-tool-button resume"
                  href="{% url 'delivery-active-job' job.id %}"
                >
                  {% if job.status == "accepted" %}
                    Resume Delivery &amp; Pickup Navigation
                  {% elif job.status == "picked_up" %}
                    Continue Delivery to Customer
                  {% else %}
                    Resume Active Delivery
                  {% endif %}
                </a>

                {% if job.store.phone %}
                  <a
                    class="driver-tool-button message"
                    href="sms:{{ job.store.phone }}"
                  >
                    Message Merchant
                  </a>

                {% elif job.store.contact_phone %}
                  <a
                    class="driver-tool-button message"
                    href="sms:{{ job.store.contact_phone }}"
                  >
                    Message Merchant
                  </a>

                {% elif job.store.business_phone %}
                  <a
                    class="driver-tool-button message"
                    href="sms:{{ job.store.business_phone }}"
                  >
                    Message Merchant
                  </a>

                {% else %}
                  <a
                    class="driver-tool-button message"
                    href="{% url 'delivery-active-job' job.id %}"
                  >
                    Merchant Details
                  </a>
                {% endif %}

                {% if job.order.customer_phone %}
                  <a
                    class="driver-tool-button message"
                    href="sms:{{ job.order.customer_phone }}"
                  >
                    Message Customer
                  </a>

                {% else %}
                  <a
                    class="driver-tool-button message"
                    href="{% url 'delivery-active-job' job.id %}"
                  >
                    Customer Details
                  </a>
                {% endif %}

                {% if job.status == "accepted" %}
                  <form
                    method="post"
                    action="{% url 'delivery-cancel-job' job.id %}"
                    onsubmit="
                      return confirm(
                        'Cancel Delivery #{{ job.id }} and return it to the available delivery pool?'
                      );
                    "
                  >
                    {% csrf_token %}

                    <button
                      class="driver-tool-button cancel"
                      type="submit"
                    >
                      Cancel &amp; Release Delivery
                    </button>
                  </form>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>

        <div class="view-all-active">
          <a href="{% url 'delivery-active-jobs' %}">
            View All Active Deliveries →
          </a>
        </div>

      {% else %}
        <div class="active-center-empty">
          You currently have no active deliveries. Accepted jobs will
          appear here with navigation and delivery-management tools.
        </div>
      {% endif %}
    </section>
  {% endif %}
  <!-- ACTIVE DELIVERY CENTER — END -->


  {% if partner and partner.is_ready_for_command_center %}
    <section class="panel">
      <div
        style="
          display:flex;
          justify-content:space-between;
          align-items:flex-start;
          gap:20px;
          flex-wrap:wrap;
        "
      >
        <div>
          <h2>
            Driver Profile
          </h2>

          <p class="help-text">
            Available jobs are matched to your Current Working ZIP.
          </p>
        </div>

        <a
          class="secondary-action"
          href="{% url 'delivery-onboarding' %}"
        >
          Edit Driver Profile
        </a>
      </div>

      <div
        style="
          margin-top:22px;
          padding:22px;
          border:1px solid rgba(242,202,82,.35);
          border-radius:18px;
          background:rgba(242,202,82,.045);
        "
      >
        <span class="profile-label">
          Driver Availability
        </span>

        <div
          style="
            margin:8px 0 18px;
            color:var(--gold-bright);
            font-size:1.45rem;
            font-weight:900;
          "
        >
          {% if partner.status == "available" %}
            🟢 Available
          {% elif partner.status == "busy" %}
            🟡 On a Break or Delivery
          {% else %}
            ⚫ Offline
          {% endif %}
        </div>

        <div
          style="
            display:flex;
            flex-wrap:wrap;
            gap:10px;
          "
        >
          <form
            method="post"
            action="{% url 'delivery-update-status' %}"
          >
            {% csrf_token %}
            <input type="hidden" name="status" value="available">

            <button class="primary-action" type="submit">
              Go Available
            </button>
          </form>

          <form
            method="post"
            action="{% url 'delivery-update-status' %}"
          >
            {% csrf_token %}
            <input type="hidden" name="status" value="busy">

            <button class="secondary-action" type="submit">
              Take a Break
            </button>
          </form>

          <form
            method="post"
            action="{% url 'delivery-update-status' %}"
          >
            {% csrf_token %}
            <input type="hidden" name="status" value="offline">

            <button class="secondary-action" type="submit">
              End Shift
            </button>
          </form>
        </div>
      </div>

      <div class="profile-grid" style="margin-top:22px;">
        <div class="profile-item">
          <span class="profile-label">
            Driver Status
          </span>

          <span class="profile-value">
            {{ partner.get_status_display }}
          </span>
        </div>

        <div class="profile-item">
          <span class="profile-label">
            Verified Address
          </span>

          <span class="profile-value">
            {% if partner.address_verified %}
              ✓ {{ partner.full_address }}
            {% else %}
              Not confirmed
            {% endif %}
          </span>
        </div>

        <div class="profile-item">
          <span class="profile-label">
            Home ZIP
          </span>

          <span class="profile-value">
            {{ partner.home_zip|default:"Not set" }}
          </span>
        </div>

        <div class="profile-item">
          <span class="profile-label">
            Current Working ZIP
          </span>

          <span class="profile-value">
            {{ partner.current_zip|default:"Not set" }}
          </span>
        </div>

        <div class="profile-item">
          <span class="profile-label">
            Service Radius
          </span>

          <span class="profile-value">
            {{ partner.service_radius_miles }} miles
          </span>
        </div>

        <div class="profile-item">
          <span class="profile-label">
            Vehicle
          </span>

          <span class="profile-value">
            {{ partner.get_vehicle_type_display }}
          </span>
        </div>

        <div class="profile-item">
          <span class="profile-label">
            Phone
          </span>

          <span class="profile-value">
            {{ partner.phone|default:"Not set" }}
          </span>
        </div>

        <div class="profile-item">
          <span class="profile-label">
            Rating
          </span>

          <span class="profile-value">
            {{ partner.rating }} ⭐
          </span>
        </div>

        <div class="profile-item">
          <span class="profile-label">
            Today's Earnings
          </span>

          <span class="profile-value">
            ${{ partner.today_earnings|floatformat:2 }}
          </span>
        </div>

        <div class="profile-item">
          <span class="profile-label">
            Weekly Earnings
          </span>

          <span class="profile-value">
            ${{ partner.weekly_earnings|floatformat:2 }}
          </span>
        </div>
      </div>
    </section>

    <section class="panel">
      <h2>
        Available Deliveries in Your Area
      </h2>

      {% for job in available_jobs %}
        <article class="job">
          <div class="job-title">
            Delivery Job #{{ job.id }}
          </div>

          <div class="job-details">
            <div>
              <strong>Order:</strong>
              #{{ job.order_id }}
            </div>

            <div>
              <strong>Store:</strong>
              {{ job.store.store_name }}
            </div>

            <div>
              <strong>Pickup ZIP:</strong>
              {{ job.pickup_zip|default:"Not provided" }}
            </div>

            <div>
              <strong>Delivery ZIP:</strong>
              {{ job.delivery_zip|default:"Not provided" }}
            </div>

            <div>
              <strong>Delivery Fee:</strong>
              ${{ job.delivery_fee|floatformat:2 }}
            </div>

            <div>
              <strong>Status:</strong>
              {{ job.get_status_display }}
            </div>
          </div>

          <form
            method="post"
            action="{% url 'delivery-accept-job' job.id %}"
            style="margin-top:18px;"
          >
            {% csrf_token %}

            <button class="primary-action" type="submit">
              Accept Delivery
            </button>
          </form>
        </article>
      {% empty %}
        <p class="empty-state">
          No delivery jobs are currently available in
          {{ partner.current_zip }}.
        </p>
      {% endfor %}
    </section>

    <section class="panel">
      <h2>
        Active Deliveries
      </h2>

      {% for job in active_delivery_jobs %}
        <article class="job">
          <div class="job-title">
            Delivery Job #{{ job.id }}
          </div>

          <div class="job-details">
            <div>
              <strong>Order:</strong>
              #{{ job.order_id }}
            </div>

            <div>
              <strong>Store:</strong>
              {{ job.store.store_name }}
            </div>

            <div>
              <strong>Delivery ZIP:</strong>
              {{ job.delivery_zip }}
            </div>

            <div>
              <strong>Status:</strong>
              {{ job.get_status_display }}
            </div>
          </div>
        </article>
      {% empty %}
        <p class="empty-state">
          You do not have an active delivery.
        </p>
      {% endfor %}
    </section>

    <section class="panel">
      <h2>
        Recently Completed Deliveries
      </h2>

      {% for job in completed_delivery_jobs %}
        <article class="job">
          <div class="job-title">
            Delivery Job #{{ job.id }}
          </div>

          <div class="job-details">
            <div>
              <strong>Order:</strong>
              #{{ job.order_id }}
            </div>

            <div>
              <strong>Store:</strong>
              {{ job.store.store_name }}
            </div>

            <div>
              <strong>Driver Payout:</strong>
              ${{ job.total_driver_payout|floatformat:2 }}
            </div>

            <div>
              <strong>Status:</strong>
              Delivered
            </div>
          </div>
        </article>
      {% empty %}
        <p class="empty-state">
          You have not completed a delivery yet.
        </p>
      {% endfor %}
    </section>

  {% elif partner %}
    {% if not partner.onboarding_completed %}
      <section class="panel warning-panel">
        <h2>
          Complete Your Driver Profile
        </h2>

        <p class="lead" style="font-size:1rem;">
          Complete onboarding before your application can be reviewed
          by the MajicMall Megaverse Driver Network team.
        </p>

        <div class="action-row">
          <a
            class="primary-action"
            href="{% url 'delivery-onboarding' %}"
          >
            Continue Driver Onboarding
          </a>
        </div>
      </section>

    {% elif partner.approval_status == "pending" %}
      <section class="panel">
        <p class="eyebrow">
          Application Under Review
        </p>

        <h2>
          Driver Approval Pending
        </h2>

        <p class="lead" style="font-size:1rem;">
          Your onboarding is complete. The MajicMall Megaverse Driver
          Network team must approve your application before you can go
          available or accept deliveries.
        </p>

        <div class="profile-grid" style="margin-top:24px;">
          <div class="profile-item">
            <span class="profile-label">
              Application Status
            </span>

            <span class="profile-value">
              Pending Approval
            </span>
          </div>

          <div class="profile-item">
            <span class="profile-label">
              Account Access
            </span>

            <span class="profile-value">
              Limited Until Approved
            </span>
          </div>
        </div>

        <div class="action-row">
          <a
            class="secondary-action"
            href="{% url 'delivery-onboarding' %}"
          >
            Review Driver Profile
          </a>
        </div>
      </section>

    {% elif partner.approval_status == "rejected" %}
      <section class="panel warning-panel">
        <p class="eyebrow">
          Application Update
        </p>

        <h2>
          Driver Application Not Approved
        </h2>

        <p class="lead" style="font-size:1rem;">
          Your application is not currently approved. You may review
          and update your profile before submitting it for another
          review.
        </p>

        <div class="action-row">
          <a
            class="primary-action"
            href="{% url 'delivery-onboarding' %}"
          >
            Update and Resubmit Application
          </a>
        </div>
      </section>

    {% elif not partner.is_active %}
      <section class="panel warning-panel">
        <p class="eyebrow">
          Driver Account Notice
        </p>

        <h2>
          Driver Account Deactivated
        </h2>

        <p class="lead" style="font-size:1rem;">
          Your driver account is currently inactive. You cannot go
          available or accept deliveries until the MajicMall
          Megaverse Driver Network team reactivates your account.
        </p>
      </section>

    {% else %}
      <section class="panel warning-panel">
        <h2>
          Driver Access Unavailable
        </h2>

        <p class="lead" style="font-size:1rem;">
          Your Driver Command Center is not currently available.
          Please review your profile or contact Driver Network support.
        </p>
      </section>
    {% endif %}

  {% else %}
    <section class="panel">
      <h2>
        Become a Driver
      </h2>

      <p class="lead" style="font-size:1rem;">
        You are signed in, but you have not registered with the
        MajicMall Megaverse Driver Network.
      </p>

      <p class="help-text">
        Available deliveries: 0
      </p>

      <div class="action-row">
        <a
          class="primary-action"
          href="{% url 'delivery-onboarding' %}"
        >
          Start Driver Onboarding
        </a>
      </div>
    </section>
  {% endif %}

{% endblock %}
