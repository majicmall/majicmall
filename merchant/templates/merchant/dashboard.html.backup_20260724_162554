{% load static merchant_success %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Merchant Dashboard | MajicMall Megaverse</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    html, body {
      max-width: 100%;
      overflow-x: hidden;
    }

    * {
      box-sizing: border-box;
    }

    .line-clamp-1 {
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
      line-clamp: 1;
    }

    .nav-active {
      position: relative;
      color: #facc15;
    }

    .nav-active::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -4px;
      width: 100%;
      height: 2px;
      background: #facc15;
      border-radius: 1px;
    }

    .spark svg {
      display: block;
      width: 100%;
      max-width: 220px;
    }

    .dashboard-shell {
      width: 100%;
      max-width: 100vw;
      overflow-x: hidden;
    }

    .safe-card {
      width: 100%;
      max-width: 100%;
      overflow: hidden;
    }

    img {
      max-width: 100%;
    }

    @media (max-width: 640px) {
      .mobile-stack {
        flex-direction: column;
        align-items: stretch;
      }

      .mobile-full {
        width: 100%;
      }

      .mobile-button {
        width: 100%;
        justify-content: center;
        text-align: center;
      }

      .mobile-title {
        font-size: 1.65rem;
        line-height: 1.1;
        word-break: break-word;
      }

      .desktop-table {
        display: none;
      }

      .mobile-cards {
        display: block;
      }
    }

    @media (min-width: 641px) {
      .mobile-cards {
        display: none;
      }
    }
  </style>

<style>
  .mm-success-plan-card {
    position: relative;
    overflow: hidden;
    padding: 1px;
    border-radius: 24px;
    background:
      linear-gradient(
        135deg,
        rgba(255, 231, 160, .92),
        rgba(212, 175, 55, .42),
        rgba(255, 255, 255, .16)
      );
    box-shadow:
      0 24px 65px rgba(0, 0, 0, .38),
      0 0 30px rgba(212, 175, 55, .13);
  }

  .mm-success-plan-glow {
    position: absolute;
    inset: -80% auto auto -25%;
    width: 28%;
    height: 260%;
    transform: rotate(24deg);
    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, .13),
        transparent
      );
    animation: mmSuccessPlanGleam 9s linear infinite;
    pointer-events: none;
  }

  @keyframes mmSuccessPlanGleam {
    from {
      left: -35%;
    }

    to {
      left: 125%;
    }
  }

  .mm-success-plan-inner {
    position: relative;
    display: grid;
    grid-template-columns:
      minmax(220px, 1.1fr)
      minmax(320px, 1.25fr)
      minmax(230px, .9fr);
    gap: 22px;
    align-items: center;
    padding: 24px;
    border-radius: 23px;
    color: #fff;
    background:
      radial-gradient(
        circle at 80% 0,
        rgba(212, 175, 55, .14),
        transparent 31%
      ),
      linear-gradient(
        145deg,
        rgba(255, 255, 255, .065),
        rgba(255, 255, 255, .014)
      ),
      rgba(5, 5, 7, .97);
  }

  .mm-success-plan-kicker {
    margin: 0 0 10px;
    color: #d4af37;
    font-size: .69rem;
    font-weight: 900;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .mm-success-plan-title-row {
    display: flex;
    align-items: center;
    gap: 13px;
  }

  .mm-success-plan-icon {
    font-size: 2.3rem;
  }

  .mm-success-plan-title {
    margin: 0;
    color: #ffe7a0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.55rem, 4vw, 2.2rem);
  }

  .mm-success-plan-summary {
    margin: 5px 0 0;
    color: rgba(255, 255, 255, .68);
    font-size: .88rem;
    line-height: 1.45;
  }

  .mm-success-plan-allocation {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .mm-success-plan-stat {
    min-width: 0;
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, .1);
    border-radius: 14px;
    background: rgba(255, 255, 255, .035);
    text-align: center;
  }

  .mm-success-plan-stat span {
    display: block;
    color: rgba(255, 255, 255, .54);
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .mm-success-plan-stat strong {
    display: block;
    margin-top: 7px;
    color: #ffe7a0;
    font-size: 1.05rem;
  }

  .mm-success-plan-message {
    margin: 0;
    color: #91ecae;
    font-size: .86rem;
    line-height: 1.45;
  }

  .mm-success-plan-message.limit {
    color: #ffd879;
  }

  .mm-success-plan-buttons {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-top: 13px;
  }

  .mm-success-plan-button {
    display: inline-flex;
    min-height: 43px;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    border-radius: 999px;
    text-align: center;
    text-decoration: none;
    font-size: .82rem;
    font-weight: 900;
  }

  .mm-success-plan-button.primary {
    color: #050505;
    border: 1px solid #d4af37;
    background:
      linear-gradient(
        135deg,
        #ffe7a0,
        #d4af37
      );
  }

  .mm-success-plan-addon {
    color: rgba(255, 255, 255, .63);
    font-size: .72rem;
    line-height: 1.4;
    text-align: center;
  }

  @media (max-width: 980px) {
    .mm-success-plan-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .mm-success-plan-inner {
      padding: 19px;
    }

    .mm-success-plan-allocation {
      grid-template-columns: 1fr;
    }

    .mm-success-plan-stat {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      text-align: left;
    }

    .mm-success-plan-stat strong {
      margin-top: 0;
      text-align: right;
    }
  }
</style>

</head>

<body class="bg-gray-950 text-white min-h-screen dashboard-shell">

  {% include "merchant/_nav.html" %}

  {% if messages %}
    <div class="w-full max-w-6xl mx-auto px-4 md:px-6 mt-4 space-y-2">
      {% for message in messages %}
        <div class="rounded-xl px-4 py-3 break-words
                    {% if message.tags == 'success' %}bg-green-900/40 text-green-200
                    {% elif message.tags == 'error' %}bg-red-900/40 text-red-200
                    {% else %}bg-gray-800 text-gray-200{% endif %}">
          {{ message }}
        </div>
      {% endfor %}
    </div>
  {% endif %}

  <main class="w-full max-w-6xl mx-auto px-4 md:px-6 py-6 md:py-8 overflow-x-hidden">

    <div class="flex items-center justify-between gap-3 mb-4 mobile-stack">
      <div></div>
      <a href="/" class="mobile-button inline-flex px-4 py-2 rounded-xl bg-gray-800 text-yellow-400 hover:bg-gray-700" aria-label="Back to Mall">
        ← Back to Mall
      </a>
    </div>

    {% if store and store.slug %}
      <div class="mt-4 mb-6">
        <div class="flex flex-wrap items-center gap-3">
          {% if store.is_public %}
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-green-400/40 bg-green-500/10 text-green-300 text-sm font-black">
              <span aria-hidden="true">●</span>
              LIVE
            </span>

            <a
              href="{% url 'storefront' store.slug %}"
              target="_blank"
              rel="noopener"
              class="mobile-button inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-yellow-400 text-black hover:opacity-90 font-black"
            >
              <span aria-hidden="true">🌐</span>
              <span>View Live Store</span>
            </a>
          {% else %}
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-yellow-400/40 bg-yellow-400/10 text-yellow-300 text-sm font-black">
              <span aria-hidden="true">●</span>
              DRAFT
            </span>

            <a
              href="{% url 'storefront' store.slug %}?preview=1"
              target="_blank"
              rel="noopener"
              class="mobile-button inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-yellow-400 text-black hover:opacity-90 font-black"
            >
              <span aria-hidden="true">👁️</span>
              <span>Preview Store</span>
            </a>
          {% endif %}

          <a
            href="{% url 'merchant-profile' %}"
            class="mobile-button inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-gray-800 text-yellow-300 hover:bg-gray-700 font-bold"
          >
            <span aria-hidden="true">✨</span>
            <span>Customize Storefront</span>
          </a>
        </div>
      </div>
    {% endif %}

    <!-- Welcome -->
    <section class="mb-8 safe-card">
      <h2 class="mobile-title text-3xl font-bold mb-2">
        Welcome, {{ merchant.display_name|default:user.get_username }}
      </h2>
      <p class="text-gray-400 break-words">Here’s an overview of your store performance and tools.</p>
      <div class="mt-3">
        <a href="{% url 'merchant-plans' %}" class="inline-flex px-3 py-2 rounded-lg text-sm font-medium hover:text-white hover:bg-zinc-800">
          Plans & Pricing
        </a>
      </div>
    </section>

    <!-- Store Brand Header -->
    <section class="mb-8 bg-gray-900 rounded-2xl p-4 md:p-6 flex items-center gap-5 mobile-stack safe-card">
      {% if store.logo %}
        <img src="{{ store.logo.url }}" alt="{{ store.store_name }}" class="h-16 w-16 shrink-0 rounded-xl object-cover shadow" />
      {% else %}
        <div class="h-16 w-16 shrink-0 rounded-xl bg-gray-800 grid place-items-center text-gray-400">🏬</div>
      {% endif %}

      <div class="flex-1 min-w-0 mobile-full">
        <h2 class="text-2xl font-bold text-yellow-400 break-words">{{ store.store_name }}</h2>
        {% if store.slogan %}
          <p class="text-gray-400 break-words">{{ store.slogan }}</p>
        {% elif store.description %}
          <p class="text-gray-400 line-clamp-1 break-words">{{ store.description }}</p>
        {% endif %}
      </div>

      {% if store %}
        <a href="{% url 'merchant-profile' %}"
           class="mobile-button inline-flex px-4 py-3 bg-gray-800 text-yellow-400 rounded-xl hover:bg-gray-700">
          ✏️ Customize Store
        </a>
      {% else %}
        <a href="{% url 'merchant-setup' %}"
           class="mobile-button inline-flex px-4 py-3 bg-gray-800 text-yellow-400 rounded-xl hover:bg-gray-700">
          🚀 Create Store
        </a>
      {% endif %}
    </section>


    {% merchant_success_summary store as success_plan %}

    {% if success_plan %}
      <section class="mm-success-plan-card mb-8 safe-card">
        <div class="mm-success-plan-glow"></div>

        <div class="mm-success-plan-inner">
          <div class="mm-success-plan-identity">
            <p class="mm-success-plan-kicker">
              Your Success Plan
            </p>

            <div class="mm-success-plan-title-row">
              <span class="mm-success-plan-icon">
                {{ success_plan.icon }}
              </span>

              <div>
                <h2 class="mm-success-plan-title">
                  {{ success_plan.name }}
                </h2>

                <p class="mm-success-plan-summary">
                  {{ success_plan.summary }}
                </p>
              </div>
            </div>
          </div>

          <div class="mm-success-plan-allocation">
            <div class="mm-success-plan-stat">
              <span>Zone Storefronts</span>
              <strong>{{ success_plan.allocation_label }}</strong>
            </div>

            <div class="mm-success-plan-stat">
              <span>Currently Used</span>
              <strong>{{ success_plan.used_storefronts }}</strong>
            </div>

            <div class="mm-success-plan-stat">
              <span>Remaining</span>

              <strong>
                {% if success_plan.remaining_storefronts == None %}
                  Custom
                {% else %}
                  {{ success_plan.remaining_storefronts }}
                {% endif %}
              </strong>
            </div>
          </div>

          <div class="mm-success-plan-actions">
            {% if success_plan.can_create_storefront %}
              <p class="mm-success-plan-message">
                {% if success_plan.remaining_storefronts == None %}
                  Your custom Zone Storefront allocation is active.
                {% elif success_plan.remaining_storefronts == 1 %}
                  You have 1 Zone Storefront remaining.
                {% else %}
                  You have
                  {{ success_plan.remaining_storefronts }}
                  Zone Storefronts remaining.
                {% endif %}
              </p>
            {% else %}
              <p class="mm-success-plan-message limit">
                Your included Zone Storefront allocation is currently used.
              </p>
            {% endif %}

            <div class="mm-success-plan-buttons">
              <a
                href="{% url 'merchant-plans' %}"
                class="mm-success-plan-button primary"
              >
                Explore Growth Opportunities
              </a>

              {% if not success_plan.can_create_storefront %}
                <span class="mm-success-plan-addon">
                  Additional Zone Storefront:
                  ${{ success_plan.additional_storefront_price }}/month
                </span>
              {% endif %}
            </div>
          </div>
        </div>
      </section>
    {% endif %}

    <!-- Stats -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 mb-10">
      <div class="bg-gray-900 p-5 md:p-6 rounded-2xl shadow safe-card">
        <div class="text-center">
          <div class="text-3xl mb-2">📦</div>
          <p class="text-gray-400">Products</p>
          <p class="text-3xl font-bold text-yellow-400">{{ product_count|default:"0" }}</p>
        </div>
        <div class="spark text-yellow-400 mt-4" data-points="{{ product_spark|default:'' }}"></div>
      </div>

      <a href="{% url 'order-list' %}" class="block safe-card">
        <div class="bg-gray-900 p-5 md:p-6 rounded-2xl shadow hover:bg-gray-800 transition">
          <div class="text-center">
            <div class="text-3xl mb-2">🧾</div>
            <p class="text-gray-400">Orders</p>
            <p class="text-3xl font-bold text-yellow-400">{{ order_count|default:"0" }}</p>
          </div>
          <div class="spark text-yellow-400 mt-4" data-points="{{ order_spark|default:'' }}"></div>
        </div>
      </a>

      <div class="bg-gray-900 p-5 md:p-6 rounded-2xl shadow safe-card">
        <div class="text-center">
          <div class="text-3xl mb-2">💰</div>
          <p class="text-gray-400">Revenue</p>
          <p class="text-3xl font-bold text-yellow-400">${{ revenue|default:0|floatformat:2 }}</p>
        </div>
        <div class="spark text-yellow-400 mt-4" data-points="{{ revenue_spark|default:'' }}"></div>
      </div>
    </section>

    <!-- Recent Orders -->
    <section class="mb-10 safe-card">
      <div class="flex items-center justify-between gap-3 mb-4 mobile-stack">
        <h3 class="text-xl font-semibold">Recent Orders</h3>
        <a href="{% url 'order-list' %}" class="text-yellow-400 hover:underline">View all →</a>
      </div>

      <!-- Desktop Table -->
      <div class="desktop-table overflow-x-auto bg-gray-900 rounded-2xl shadow">
        <table class="min-w-full text-left">
          <thead class="bg-gray-800 text-gray-300 uppercase text-sm">
            <tr>
              <th class="px-6 py-3">Order</th>
              <th class="px-6 py-3">Status</th>
              <th class="px-6 py-3">Date</th>
              <th class="px-6 py-3">Total</th>
              <th class="px-6 py-3">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-800">
            {% for order in recent_orders %}
            <tr class="hover:bg-gray-800">
              <td class="px-6 py-3">#{{ order.id }}</td>
              <td class="px-6 py-3">{{ order.status|title }}</td>
              <td class="px-6 py-3">{{ order.created_at|date:"M d, Y" }}</td>
              <td class="px-6 py-3">${{ order.total|floatformat:2 }}</td>
              <td class="px-6 py-3">
                <a href="{% url 'merchant-fulfillment-order' order.id %}" class="text-yellow-400 hover:underline">Open Fulfillment</a>
              </td>
            </tr>
            {% empty %}
            <tr>
              <td colspan="5" class="px-6 py-6 text-center text-gray-400">
                No orders yet. <a href="{% url 'order-list' %}" class="text-yellow-400 hover:underline">See all</a>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <!-- Mobile Cards -->
      <div class="mobile-cards space-y-4">
        {% for order in recent_orders %}
          <div class="bg-gray-900 rounded-2xl p-4 border border-gray-800">
            <div class="flex justify-between gap-3">
              <div>
                <p class="text-gray-400 text-sm">Order</p>
                <p class="font-bold text-yellow-400">#{{ order.id }}</p>
              </div>
              <div class="text-right">
                <p class="text-gray-400 text-sm">Total</p>
                <p class="font-bold">${{ order.total|floatformat:2 }}</p>
              </div>
            </div>

            <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
              <div>
                <p class="text-gray-400">Status</p>
                <p>{{ order.status|title }}</p>
              </div>
              <div>
                <p class="text-gray-400">Date</p>
                <p>{{ order.created_at|date:"M d, Y" }}</p>
              </div>
            </div>

            <a href="{% url 'merchant-fulfillment-order' order.id %}" class="mt-4 inline-flex w-full justify-center px-4 py-3 rounded-xl bg-yellow-400 text-black font-bold">
              View Order
            </a>
          </div>
        {% empty %}
          <div class="bg-gray-900 rounded-2xl p-6 text-center text-gray-400">
            No orders yet.
            <a href="{% url 'order-list' %}" class="text-yellow-400 hover:underline">See all</a>
          </div>
        {% endfor %}
      </div>
    </section>

    <!-- Quick Actions -->
    <section class="mb-10 safe-card">
      <h3 class="text-xl font-semibold mb-4">Quick Actions</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="{% url 'merchant-add-product' %}" class="mobile-button px-5 py-3 bg-yellow-400 text-black rounded-xl shadow hover:opacity-90 font-bold">
          ➕ Add Product
        </a>
        <a href="{% url 'merchant-category-list' %}" class="mobile-button px-5 py-3 bg-gray-800 text-yellow-400 rounded-xl shadow hover:bg-gray-700 font-bold">
          🗂️ Manage Categories
        </a>
        <a href="{% url 'merchant-add-category' %}" class="mobile-button px-5 py-3 bg-gray-800 text-yellow-400 rounded-xl shadow hover:bg-gray-700 font-bold">
          ➕ Add Category
        </a>
        <a href="{% url 'merchant-profile' %}" class="mobile-button px-5 py-3 bg-gray-800 text-yellow-400 rounded-xl shadow hover:bg-gray-700 font-bold">
          ✏️ Customize Store
        </a>
        <a href="{% url 'order-list' %}" class="mobile-button px-5 py-3 bg-gray-800 text-yellow-400 rounded-xl shadow hover:bg-gray-700 font-bold">
          📦 View Orders
        </a>
        <a href="{% url 'merchant-reports' %}" class="mobile-button px-5 py-3 bg-gray-800 text-yellow-400 rounded-xl shadow hover:bg-gray-700 font-bold">
          📊 View Reports
        </a>
      </div>
    </section>

    <!-- Products -->
    <section class="safe-card">
      <div class="flex items-center justify-between gap-3 mb-4 mobile-stack">
        <h3 class="text-xl font-semibold">Your Products</h3>
        <a href="{% url 'merchant-add-product' %}" class="text-yellow-400 hover:underline">Add product →</a>
      </div>

      <!-- Desktop Table -->
      <div class="desktop-table overflow-x-auto bg-gray-900 rounded-2xl shadow">
        <table class="min-w-full text-left">
          <thead class="bg-gray-800 text-gray-300 uppercase text-sm">
            <tr>
              <th class="px-6 py-3">Product</th>
              <th class="px-6 py-3">Price</th>
              <th class="px-6 py-3">Created</th>
              <th class="px-6 py-3">Actions</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-800">
            {% for product in products %}
              <tr class="hover:bg-gray-800 align-middle">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    {% if product.image %}
                      <img src="{{ product.image.url }}" alt="{{ product.name }}" class="w-10 h-10 rounded-lg object-cover bg-gray-800">
                    {% else %}
                      <div class="w-10 h-10 rounded-lg bg-gray-800 grid place-items-center text-gray-500">🖼️</div>
                    {% endif %}
                    <div class="min-w-0">
                      <div class="font-semibold text-white truncate max-w-[320px]">{{ product.name }}</div>
                      {% if product.description %}
                        <div class="text-xs text-gray-400 line-clamp-1 max-w-[420px]">{{ product.description }}</div>
                      {% endif %}
                    </div>
                  </div>
                </td>

                <td class="px-6 py-4 text-gray-200">
                  ${{ product.price|floatformat:2 }}
                </td>

                <td class="px-6 py-4 text-gray-300">
                  {{ product.created_at|date:"M d, Y" }}
                </td>

                <td class="px-6 py-4">
                  <div class="flex items-center gap-2">
                    <a href="{% url 'merchant-edit-product' product.id %}"
                       class="px-3 py-2 bg-yellow-400 text-black rounded-lg text-sm hover:opacity-90">
                      Edit
                    </a>
                    <a href="{% url 'merchant-delete-product' product.id %}"
                       class="px-3 py-2 bg-red-600/80 text-white rounded-lg text-sm hover:bg-red-600"
                       title="Delete requires confirmation">
                      Delete
                    </a>
                  </div>
                </td>
              </tr>
            {% empty %}
              <tr>
                <td colspan="4" class="px-6 py-8 text-center text-gray-400">
                  No products yet. Click <span class="text-yellow-400 font-semibold">Add Product</span> to create your first one.
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <!-- Mobile Product Cards -->
      <div class="mobile-cards space-y-4">
        {% for product in products %}
          <div class="bg-gray-900 rounded-2xl p-4 border border-gray-800">
            <div class="flex gap-3">
              {% if product.image %}
                <img src="{{ product.image.url }}" alt="{{ product.name }}" class="w-16 h-16 rounded-xl object-cover bg-gray-800 shrink-0">
              {% else %}
                <div class="w-16 h-16 rounded-xl bg-gray-800 grid place-items-center text-gray-500 shrink-0">🖼️</div>
              {% endif %}

              <div class="min-w-0 flex-1">
                <h4 class="font-bold text-white break-words">{{ product.name }}</h4>
                <p class="text-yellow-400 font-bold mt-1">${{ product.price|floatformat:2 }}</p>
                <p class="text-xs text-gray-400 mt-1">{{ product.created_at|date:"M d, Y" }}</p>
              </div>
            </div>

            {% if product.description %}
              <p class="text-sm text-gray-400 mt-3 break-words">{{ product.description|truncatewords:18 }}</p>
            {% endif %}

            <div class="grid grid-cols-2 gap-3 mt-4">
              <a href="{% url 'merchant-edit-product' product.id %}"
                 class="px-3 py-3 bg-yellow-400 text-black rounded-xl text-sm font-bold text-center hover:opacity-90">
                Edit
              </a>
              <a href="{% url 'merchant-delete-product' product.id %}"
                 class="px-3 py-3 bg-red-600/80 text-white rounded-xl text-sm font-bold text-center hover:bg-red-600">
                Delete
              </a>
            </div>
          </div>
        {% empty %}
          <div class="bg-gray-900 rounded-2xl p-6 text-center text-gray-400">
            No products yet. Click <span class="text-yellow-400 font-semibold">Add Product</span> to create your first one.
          </div>
        {% endfor %}
      </div>
    </section>
  </main>

  <script>
    (function () {
      function drawSpark(el, points) {
        const w = 220, h = 40, p = 4;
        if (!points || points.length < 2) {
          points = Array.from({length: 16}, (_, i) => {
            const base = 50 + 30 * Math.sin(i / 2);
            const jitter = Math.random() * 15 - 7.5;
            return Math.max(0, base + jitter);
          });
        }
        const min = Math.min(...points);
        const max = Math.max(...points);
        const span = (max - min) || 1;
        const stepX = (w - 2*p) / (points.length - 1);
        const mapY = v => h - p - ((v - min) / span) * (h - 2*p);
        let d = "";
        points.forEach((v, i) => {
          const x = p + i * stepX;
          const y = mapY(v);
          d += (i === 0 ? `M ${x} ${y}` : ` L ${x} ${y}`);
        });
        el.innerHTML = `
          <svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">
            <line x1="0" y1="${h-1}" x2="${w}" y2="${h-1}" stroke="rgba(255,255,255,0.08)" />
            <path d="${d}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        `;
      }

      document.querySelectorAll('.spark').forEach(el => {
        const raw = (el.getAttribute('data-points') || '').trim();
        let points = null;
        if (raw) {
          try {
            points = raw.startsWith('[') ? JSON.parse(raw) : raw.split(',').map(x => parseFloat(x));
            if (!Array.isArray(points)) points = null;
          } catch (e) { points = null; }
        }
        drawSpark(el, points);
      });
    })();
  </script>

